# Copying this file alone does not create usable keys. Run `npm run keys` first.
# Never commit .env. The generator preserves existing nonempty values.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Set only when direct access to the Node port is blocked and your proxy is trusted.
# TRUST_PROXY=1

# Replace this contact before production; VAPID identifies the sender.
VAPID_SUBJECT=mailto:local-test@example.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Exactly 32 random bytes encoded in base64; keep unchanged across restarts.
DATA_ENCRYPTION_KEY=
# At least 32 random bytes. Keep unchanged across web and worker restarts.
SESSION_SECRET=

# Only needed for compose.yaml / public HTTPS deployment.
# APP_DOMAIN is the bare DNS name; PUBLIC_ORIGIN must be https://<APP_DOMAIN>.
APP_DOMAIN=
ACME_EMAIL=
