{
  "name": "salary-guardians",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"node --env-file-if-exists=.env --import tsx --watch server/app.ts\" \"vite --host 0.0.0.0\" \"node --env-file-if-exists=.env --import tsx --watch server/worker.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/app.ts",
    "build": "tsc --noEmit && node scripts/build-client.mjs",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env --import tsx server/app.ts",
    "worker": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "worker:prod": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "keys": "node --import tsx scripts/generate-keys.ts",
    "cf:prepare": "node --import tsx scripts/cloudflare-prepare.ts",
    "cf:login": "node scripts/cloudflare-cli.mjs login --device --browser=false --scopes account:read user:read workers_scripts:write workers_tail:read d1:write",
    "cf:whoami": "node scripts/cloudflare-cli.mjs whoami",
    "cf:migrate:local": "node scripts/cloudflare-cli.mjs d1 migrations apply salary-guardians-db --local",
    "cf:dev": "node scripts/cloudflare-cli.mjs dev --local --port 8787 --ip 127.0.0.1 --test-scheduled",
    "cf:dry-run": "node scripts/cloudflare-cli.mjs deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "node scripts/cloudflare-cli.mjs deploy",
    "cf:deploy:dashboard": "node scripts/cloudflare-dashboard-deploy.mjs",
    "test:e2e:cloudflare": "node scripts/cloudflare-e2e.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "miniflare": "^5.20261006.1-alpha",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "wrangler": "^4.149.0"
  }
}
